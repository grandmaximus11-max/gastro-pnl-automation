# Copy to .env and fill in. Never commit the real .env.

# --- Telegram bots ---
BOT_TOKEN=                 # P&L bot (BotFather)
BOT_TOKEN_KASA=            # shift-closing wizard bot

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=

# --- Google Sheets / Drive (OAuth) ---
SHEETS_ID=                 # target spreadsheet id
GDRIVE_FOLDER_ID=          # Drive folder for uploaded documents
DRIVE_FAKTURY_FOLDER_ID=   # invoices archive folder id
DRIVE_UMBRELLA_FOLDER_ID=  # parent folder id

# --- FIO Banka API ---
FIO_TOKEN=                 # FIO read-only API token
FIO_AUTOCHECK=0            # 1 = run periodic bank reconciliation, 0 = paused

# --- Gmail invoice monitor ---
GMAIL_LABEL_NAME=Invoices  # label applied to processed mail

# --- Notifications ---
NOTIFY_CHAT_ID=            # owner Telegram chat id
NOTIFY_MANAGER_TG_ID=      # manager Telegram id
